# API keys — copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# AI provider: "mock" (default, no credentials needed) or "openai" or "watsonx"
AI_PROVIDER=mock

# Required only when AI_PROVIDER=openai
OPENAI_API_KEY=

# Required only when AI_PROVIDER=watsonx
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=
